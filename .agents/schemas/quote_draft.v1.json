{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuoteDraftSchema",
  "description": "Schéma de devis structuré pour solopreneur belge émis par le persona deviseur-be.",
  "type": "object",
  "required": [
    "schema_version",
    "quote_number",
    "issue_date",
    "validity_days",
    "supplier",
    "customer",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "quote_number": {
      "type": "string",
      "pattern": "^DEV-[0-9]{4}-[0-9]{3,}$"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "validity_days": {
      "type": "integer",
      "minimum": 7,
      "maximum": 90,
      "default": 30
    },
    "pricing_model": {
      "type": "string",
      "enum": ["tjm", "forfait", "mixed"]
    },
    "supplier": {
      "type": "object",
      "required": ["name", "bce_number"],
      "properties": {
        "name": {"type": "string"},
        "bce_number": {"type": "string"},
        "vat_number": {"type": "string"}
      }
    },
    "customer": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "bce_number": {"type": "string"},
        "vat_number": {"type": "string"}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["description", "quantity", "unit_price", "vat_rate"],
        "properties": {
          "description": {"type": "string"},
          "quantity": {"type": "number", "minimum": 0.1},
          "unit_price": {"type": "number", "minimum": 0.0},
          "vat_rate": {"type": "number", "enum": [0.21, 0.12, 0.06, 0.00]},
          "phase": {"type": "string"}
        }
      }
    },
    "deposit_percentage": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0,
      "default": 30.0
    },
    "notes": {
      "type": "string"
    }
  }
}
